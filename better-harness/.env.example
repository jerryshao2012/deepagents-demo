# Better Harness Environment Configuration
# Copy this file to .env and update with your settings

# Ollama Configuration (for local models)
OLLAMA_API_BASE=http://localhost:11434

# Deep Agents Root (path to deepagents repository)
# DEEPAGENTS_ROOT=/path/to/deepagents

# Model Configuration (set in TOML config, but can be overridden via environment)
# MODEL_NAME=ollama:gemma4:latest
