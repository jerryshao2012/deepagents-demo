# =============================================================================
# Deep Agents Harness Demo - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# =============================================================================
# SEARCH ENGINE API KEYS
# =============================================================================

# Tavily API Key (Required for web search)
# Get your free API key at: https://app.tavily.com
# This value is managed via Azure Key Vault - see secrets.sh
# TAVILY_API_KEY=

# Alternative: Brave Search (Optional, uncomment if using)
# BRAVE_SEARCH_API_KEY=your-brave-search-key-here

# =============================================================================
# OLLAMA CONFIGURATION
# =============================================================================

# Ollama API Base (default)
# OLLAMA_API_BASE=http://localhost:11434

# Model name
# MODEL_NAME=qwen3.6:35b-a3b

# =============================================================================
# OPTIONAL: OTHER API KEYS (Not needed for this demo)
# =============================================================================

# OpenAI API Key (if you want to try cloud models later)
# OPENAI_API_KEY=sk-your-openai-key-here

# Azure OpenAI Configuration
# These values are managed via Azure Key Vault - see secrets.sh
# AZURE_OPENAI_ENDPOINT=https://azureopenaiue2.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=Deployment-Model-gpt-4.1
# AZURE_OPENAI_API_KEY=your-key-here
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Anthropic API Key (for Claude models)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google Gemini API Key
# GOOGLE_API_KEY=your-google-api-key-here

# DashScope API Key (for Qwen models via cloud)
# DASHSCOPE_API_KEY=your-dashscope-key-here

# MiniMax API Key
# MINIMAX_API_KEY=your-minimax-key-here

# =============================================================================
# OPTIONAL: LangSmith API Key (required for LangGraph local server)
# Get your key at: https://smith.langchain.com/settings
# =============================================================================
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# This value is managed via Azure Key Vault - see secrets.sh
# LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=deep-research-deepagent

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=ERROR

# Research Agent Configuration
# Maximum number of concurrent research units (sub-agents) that can run simultaneously
MAX_CONCURRENT_RESEARCH_UNITS=3
# Maximum number of iterations per researcher agent before stopping
MAX_RESEARCHER_ITERATIONS=3

# Evaluation Tracking (for langgraph dev server)
# Enable automatic metrics logging during development (true/false)
ENABLE_EVAL_TRACKING=true
# Path to JSONL file for storing operational metrics
EVAL_HISTORY_FILE=./output/eval_history/server_runs.jsonl

# =============================================================================
# RELIABILITY & RATE LIMITING
# =============================================================================

# Proactive Rate Shaping (TPM and RPM limits)
# Set these based on your provider's deployment quotas
# Tokens Per Minute:
# Represents the maximum number of tokens (input + output) you are allowed to send to the model provider within a
# rolling 60-second window.
MODEL_TPM=500000
# Requests Per Minute:
# Represents the maximum number of individual API calls you can make per minute.
MODEL_RPM=500

# Reactive Retries (Optional Exponential Backoff and Jitter)
# Maximum number of retry attempts when rate limit errors occur
MODEL_MAX_RETRIES=2
# Initial backoff time in seconds before first retry
MODEL_INITIAL_BACKOFF=0.5
# Maximum backoff time in seconds (cap for exponential backoff)
MODEL_MAX_BACKOFF=10.0
# Multiplier for exponential backoff (backoff = initial * multiplier^attempt)
MODEL_BACKOFF_MULTIPLIER=1.5
# Add jitter to prevent thundering herd problem (true/false)
MODEL_RETRY_JITTER=true

# =============================================================================
# DOCUMENT UPLOAD API CONFIGURATION
# =============================================================================

# API Key for document upload endpoint authentication
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This value is managed via Azure Key Vault - see secrets.sh
# UPLOAD_API_KEY=

# Host and port for the document upload API server
# Use 0.0.0.0 to listen on all interfaces (for public access)
UPLOAD_HOST=0.0.0.0
UPLOAD_PORT=8000
